{
  "id": "royalroad",
  "name": "Royal Road",
  "description": "Your followed and saved Royal Road serials",
  "version": "1.4.0",
  "apiVersion": 4,
  "site": "https://www.royalroad.com",
  "iconUrl": "https://www.royalroad.com/favicon.ico",
  "lang": "en",
  "bookIdPrefix": "rr",
  "allowedHosts": ["royalroad.com", "royalroadl.com"],
  "minRequestIntervalMs": 700,
  "capabilities": ["search", "lists", "auth", "membership", "progressSync", "resolveUrl", "updates"],
  "lists": [
    { "id": "follow", "title": "Follow", "icon": "add", "membershipToggle": true, "syncable": true },
    { "id": "favorite", "title": "Favorite", "icon": "favorite", "membershipToggle": true, "syncable": false },
    { "id": "readlater", "title": "Read Later", "icon": "schedule", "membershipToggle": true, "syncable": false }
  ],
  "auth": {
    "web": { "url": "https://www.royalroad.com/account/login", "doneCookie": ".AspNetCore.Identity.Application" },
    "note": "Sign in on Royal Road's own page. Flow Reader keeps the session cookies, never your password."
  },
  "settings": [
    {
      "key": "authorNotes",
      "type": "toggle",
      "label": "Include author notes",
      "description": "Append author notes after the chapter text",
      "default": true
    }
  ],
  "shareHosts": ["royalroad.com", "royalroadl.com"]
}
