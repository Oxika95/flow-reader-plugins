{
  "id": "royalroad",
  "name": "Royal Road",
  "description": "Your followed and saved Royal Road serials",
  "version": "1.5.1",
  "apiVersion": 5,
  "kind": "source",
  "site": "https://www.royalroad.com",
  "lang": "en",
  "bookIdPrefix": "rr",
  "allowedHosts": ["royalroad.com", "royalroadl.com"],
  "minRequestIntervalMs": 700,
  "capabilities": ["search", "lists", "auth", "membership", "progressSync", "resolveUrl", "updates"],
  "lists": [
    { "id": "follow", "title": "Follow", "icon": "bookmark", "membershipToggle": true, "syncable": true, "notifyDefault": true },
    { "id": "favorite", "title": "Favorite", "icon": "favorite", "membershipToggle": true, "syncable": true },
    { "id": "readlater", "title": "Read Later", "icon": "schedule", "membershipToggle": true, "syncable": true }
  ],
  "auth": {
    "web": { "url": "https://www.royalroad.com/account/login", "doneCookie": ".AspNetCore.Identity.Application" },
    "note": "Sign in on Royal Road's own page. Flow Reader keeps the session cookies, never your password."
  },
  "sitePages": [
    { "title": "Sign in", "url": "https://www.royalroad.com/account/login" },
    { "title": "Follows", "url": "https://www.royalroad.com/my/follows", "listId": "follow" },
    { "title": "Favorites", "url": "https://www.royalroad.com/my/favorites", "listId": "favorite" },
    { "title": "Read Later", "url": "https://www.royalroad.com/my/readlater", "listId": "readlater" }
  ],
  "settings": [
    {
      "key": "authorNotes",
      "type": "toggle",
      "label": "Include author notes",
      "description": "Append author notes after the chapter text",
      "default": false
    }
  ],
  "shareHosts": ["royalroad.com", "royalroadl.com"]
}
